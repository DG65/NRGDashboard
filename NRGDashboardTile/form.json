{
  "elements": [
    {
      "type": "ExpansionPanel",
      "caption": "Dokumentation & Hilfe",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "NRG Dashboard erkennt automatisch alle installierten NRG-Stack-Partnermodule (InverterHub, MeterHub, ChargerHub, HeishaMon, Tessie) über deren Verträge - keine manuelle Verknüpfung von Variablen-IDs nötig."
        },
        {
          "type": "Label",
          "caption": "Version 0.1.0-beta.1"
        }
      ]
    },
    {
      "type": "Button",
      "caption": "Geräte jetzt suchen",
      "onClick": "NRGDASH_Discover($id);"
    },
    {
      "type": "Label",
      "name": "DiscoveryResult",
      "caption": ""
    },
    {
      "type": "ExpansionPanel",
      "caption": "Darstellung",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Die Kreisfarben sind fest an die jeweilige Größe gebunden (Solar = Gelb, Netz = Grün/Rot je nach Richtung, Haus = Grün-Rot-Verlauf je nach Netzbezugsanteil, Batterie = Blau) und nicht anpassbar."
        },
        {
          "type": "SelectColor",
          "name": "ColorBackground",
          "caption": "Hintergrundfarbe (-1 = Systemstandard)"
        },
        {
          "type": "ValidationTextBox",
          "name": "FontFamily",
          "caption": "Schriftart (leer/„system“ = Systemschrift)"
        },
        {
          "type": "NumberSpinner",
          "name": "TransitionMs",
          "caption": "Übergangszeit aktiv/inaktiv (0 = ohne Animation)",
          "minimum": 0,
          "maximum": 5000,
          "suffix": "ms"
        },
        {
          "type": "NumberSpinner",
          "name": "FlowRefW",
          "caption": "Fluss-Tempo: Leistung für Höchsttempo",
          "minimum": 500,
          "maximum": 100000,
          "suffix": "W"
        },
        {
          "type": "Label",
          "caption": "Das Tempo der laufenden Dreiecke folgt der Leistung. Bei diesem Wert (und darüber) laufen sie mit Höchsttempo — je kleiner der Wert, desto deutlicher unterscheiden sich typische Alltagsleistungen (z. B. 1 vs. 5 kW) sichtbar im Tempo. Vorgabe: 10000 W."
        }
      ]
    },
    {
      "type": "Button",
      "caption": "Stil zurücksetzen",
      "onClick": "NRGDASH_ResetStyle($id);"
    }
  ]
}
