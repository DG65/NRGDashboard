{
  "elements": [
    {
      "type": "ExpansionPanel",
      "caption": "Dokumentation & Hilfe",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "NRG Dashboard erkennt automatisch alle installierten NRG-Stack-Partnermodule (InverterHub, MeterHub, ChargerHub, HeishaMon, Tessie) über deren Verträge - keine manuelle Verknüpfung von Variablen-IDs nötig."
        },
        {
          "type": "Label",
          "caption": "Version 0.1.0-beta.1"
        }
      ]
    },
    {
      "type": "Button",
      "caption": "Geräte jetzt suchen",
      "onClick": "NRGDASH_Discover($id);"
    },
    {
      "type": "Label",
      "name": "DiscoveryResult",
      "caption": ""
    },
    {
      "type": "ExpansionPanel",
      "caption": "Manuelle Datenpunkte (optional, ohne installiertes Partnermodul)",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Nur nötig, wenn kein NRG-Stack-Partnermodul (InverterHub, MeterHub, ChargerHub, HeishaMon) installiert ist oder ein Wert von dort fehlt. Ergänzt die automatische Suche, ersetzt sie nicht - beide wirken gleichzeitig. Vorzeichen-Konvention: Netz + = Einspeisung, Batterie + = Entladen - stimmt die Richtung nicht, den passenden Schalter setzen."
        },
        { "type": "SelectVariable", "name": "ManualPvID", "caption": "Solar-Leistung" },
        { "type": "SelectVariable", "name": "ManualGridID", "caption": "Netz-/Zählerleistung (+ Einspeisung / − Bezug)" },
        { "type": "CheckBox", "name": "ManualGridInvert", "caption": "Netz-Leistung invertieren" },
        { "type": "SelectVariable", "name": "ManualBatID", "caption": "Batterie-Leistung (+ Entladen / − Laden)" },
        { "type": "CheckBox", "name": "ManualBatInvert", "caption": "Batterie-Leistung invertieren" },
        { "type": "SelectVariable", "name": "ManualSocID", "caption": "Batterie-Ladestand (SOC, %)" },
        { "type": "SelectVariable", "name": "ManualHouseID", "caption": "Echter Hauslastzähler (optional, ersetzt die berechnete Näherung)" }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Weitere Verbraucher (optional)",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Beliebig viele zusätzliche Verbraucher, die als eigene Kreise dargestellt werden - unabhängig davon, ob sie über ein Hub-Modul erkannt wurden. Nicht jeder Haushalt hat dieselben Geräte; die Art bestimmt das Icon, die Bezeichnung den Text unter dem Kreis (leer = Vorgabe der Art). Die letzten drei Spalten gelten nur für die Art „Wallbox“ und dürfen sonst leer bleiben - sie beschreiben, woran die Wallbox erkennt, dass ein Fahrzeug eingesteckt ist."
        },
        {
          "type": "List",
          "name": "Consumers",
          "caption": "Verbraucher",
          "rowCount": 6,
          "add": true,
          "delete": true,
          "columns": [
            {
              "caption": "Art",
              "name": "Type",
              "width": "200px",
              "add": "wallbox",
              "edit": {
                "type": "Select",
                "options": [
                  { "caption": "Wallbox",             "value": "wallbox" },
                  { "caption": "Wärmepumpe",          "value": "heatpump" },
                  { "caption": "Klimaanlage",         "value": "ac" },
                  { "caption": "Pool-Wärmepumpe",     "value": "poolheat" },
                  { "caption": "Pool-Pumpe",          "value": "poolpump" },
                  { "caption": "Sauna",               "value": "sauna" },
                  { "caption": "Warmwasser",          "value": "boiler" },
                  { "caption": "Trockner",            "value": "dryer" },
                  { "caption": "Waschmaschine",       "value": "washer" },
                  { "caption": "Spülmaschine",        "value": "dishwasher" },
                  { "caption": "Backofen",            "value": "oven" },
                  { "caption": "Herd",                "value": "stove" },
                  { "caption": "Kühl-/Gefriergerät",  "value": "fridge" },
                  { "caption": "Küche",               "value": "kitchen" },
                  { "caption": "Heizung",             "value": "heater" },
                  { "caption": "Lüftung",             "value": "vent" },
                  { "caption": "Beleuchtung",         "value": "light" },
                  { "caption": "Server / Netzwerk",   "value": "it" },
                  { "caption": "Werkstatt",           "value": "workshop" },
                  { "caption": "Garage",              "value": "garage" },
                  { "caption": "Sonstiger Verbraucher", "value": "other" }
                ]
              }
            },
            {
              "caption": "Bezeichnung (leer = Vorgabe der Art)",
              "name": "Name",
              "width": "220px",
              "add": "",
              "edit": { "type": "ValidationTextBox" }
            },
            {
              "caption": "Leistungs-Variable",
              "name": "VariableID",
              "width": "240px",
              "add": 0,
              "edit": { "type": "SelectVariable" }
            },
            {
              "caption": "Nur Wallbox: Verbunden-Variable",
              "name": "PlugID",
              "width": "240px",
              "add": 0,
              "edit": { "type": "SelectVariable" }
            },
            {
              "caption": "Bedingung",
              "name": "PlugOp",
              "width": "230px",
              "add": "truthy",
              "edit": {
                "type": "Select",
                "options": [
                  { "caption": "ist gesetzt (wahr / ≠ 0 / nicht leer)", "value": "truthy" },
                  { "caption": "gleich Wert",   "value": "eq" },
                  { "caption": "ungleich Wert", "value": "ne" }
                ]
              }
            },
            {
              "caption": "Vergleichswert",
              "name": "PlugVal",
              "width": "auto",
              "add": "",
              "edit": { "type": "ValidationTextBox" }
            }
          ]
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Darstellung",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Die Kreisfarben sind fest an die jeweilige Größe gebunden (Solar = Gelb, Netz = Grün/Rot je nach Richtung, Haus = Grün-Rot-Verlauf je nach Netzbezugsanteil, Batterie = Blau) und nicht anpassbar."
        },
        {
          "type": "SelectColor",
          "name": "ColorBackground",
          "caption": "Hintergrundfarbe (-1 = Systemstandard)"
        },
        {
          "type": "ValidationTextBox",
          "name": "FontFamily",
          "caption": "Schriftart (leer/„system“ = Systemschrift)"
        },
        {
          "type": "NumberSpinner",
          "name": "TransitionMs",
          "caption": "Übergangszeit aktiv/inaktiv (0 = ohne Animation)",
          "minimum": 0,
          "maximum": 5000,
          "suffix": "ms"
        },
        {
          "type": "NumberSpinner",
          "name": "FlowRefW",
          "caption": "Fluss-Tempo: Leistung für Höchsttempo",
          "minimum": 500,
          "maximum": 100000,
          "suffix": "W"
        },
        {
          "type": "Label",
          "caption": "Das Tempo der laufenden Dreiecke folgt der Leistung. Bei diesem Wert (und darüber) laufen sie mit Höchsttempo — je kleiner der Wert, desto deutlicher unterscheiden sich typische Alltagsleistungen (z. B. 1 vs. 5 kW) sichtbar im Tempo. Vorgabe: 10000 W."
        }
      ]
    },
    {
      "type": "Button",
      "caption": "Stil zurücksetzen",
      "onClick": "NRGDASH_ResetStyle($id);"
    }
  ]
}
