        },
        {
          "type": "SelectVariable",
          "name": "ManualFan2SpeedID",
          "caption": "Lüfterdrehzahl 2 (U/min) - nur bei Außen-/Monoblockgeräten mit 2 Ventilatoren"
        },
        {
          "type": "SelectVariable",
          "name": "ManualInternalHeaterStateID",
          "caption": "Heizstab intern aktiv (bool)"
        },
        {
          "type": "SelectVariable",
