        },
        {
          "type": "SelectVariable",
          "name": "ManualZ2MixingValvePositionID",
          "caption": "Mischventil Heizkreis 2, Stellung in % (optional)"
        },
        {
          "type": "Label",
          "caption": "Sonstiges"
        },
        {
          "type": "SelectVariable",
          "name": "ManualIndoorPipeTempID",
          "caption": "Rohrtemperatur Innengerät/Verdampfer (°C, optional)"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Darstellung",
      "expanded": false,
      "items": [
        {
          "type": "SelectColor",
          "name": "ColorBackground",
          "caption": "Hintergrundfarbe (-1 = Systemstandard)"
        },
        {
          "type": "ValidationTextBox",
          "name": "FontFamily",
