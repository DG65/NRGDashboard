        },
        {
          "type": "CheckBox",
          "name": "LightTheme",
          "caption": "Symcon-Oberfläche ist auf Hell gestellt (Symcon bietet der Kachel keine automatische Erkennung an)"
        },
        {
          "type": "ValidationTextBox",
          "name": "Zone1Caption",
          "caption": "Beschriftung Heizkreis 1 (z. B. „Radiatoren“ – leer lassen für keine)"
        },
        {
          "type": "ValidationTextBox",
          "name": "Zone2Caption",
          "caption": "Beschriftung Heizkreis 2 (nur sichtbar, wenn die Wärmepumpe eine zweite Zone meldet)"
        },
        {
          "type": "Label",
          "caption": "Heizkörper/Fußbodenheizung je Heizkreis, Anlagenbauart (Split/Monoblock, Puffer, Warmwasser-Tank), Wasserfluss-Darstellung und Simulation: als Schalter direkt unter dieser Instanz im Objektbaum bzw. in der aufgezogenen Kachelansicht (Doppelpfeil), nicht hier im Formular."
        }
      ]
    },
    {
      "type": "Button",
      "caption": "Einführungs-Tour erneut anzeigen",
      "onClick": "NRGDASHHEAT_ResetTour($id);"
    }
